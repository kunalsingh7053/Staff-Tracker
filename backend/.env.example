# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Staff-Tracker?retryWrites=true&w=majority

# JWT Secrets & Expiry
JWT_SECRET=staff_tracker_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=staff_tracker_refresh_secret_key_production_2026
JWT_REFRESH_EXPIRES_IN=30d

# Company Default Policies
DEFAULT_WORK_SHIFT_START=09:00
DEFAULT_WORK_SHIFT_END=18:00
DEFAULT_GRACE_MINUTES=15
DEFAULT_PER_KM_RATE=6.5
DEFAULT_HALF_DAY_HOURS=4.5
DEFAULT_FULL_DAY_HOURS=8.0

# GPS & Distance Tracking Thresholds
GPS_ACCURACY_THRESHOLD_METERS=40
MAX_TRAVEL_SPEED_KMH=130
MIN_TRAVEL_DISPLACEMENT_METERS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
